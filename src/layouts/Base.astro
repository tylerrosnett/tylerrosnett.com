---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Tyler Rosnett', description = 'Software engineer & occasional blogger' } = Astro.props;
---

<!doctype html>
<html lang="en" class="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Restore theme from localStorage on page load
      const savedTheme = localStorage.getItem('theme') || 'mocha';
      document.documentElement.classList.remove('latte', 'frappe', 'macchiato', 'mocha');
      document.documentElement.classList.add(savedTheme);
    </script>
  </body>
</html>
