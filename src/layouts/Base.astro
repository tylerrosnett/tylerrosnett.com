---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Tyler Rosnett', description = 'Software engineer & occasional blogger' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      // Apply theme before first paint to prevent flash
      const savedTheme = localStorage.getItem('theme') || 'mocha';
      document.documentElement.classList.add(savedTheme);
    </script>

  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const prefetchedUrls = new Set<string>();
      const canPrefetch = HTMLLinkElement.supports?.('prefetch') ?? true;
      const connection = (navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }).connection;
      const shouldPrefetch =
        canPrefetch && !connection?.saveData && connection?.effectiveType !== '2g';

      document.addEventListener('pointerover', (e) => {
        if (!shouldPrefetch) return;

        const link = e.target instanceof Element ? e.target.closest('a[href]') : null;
        if (!link) return;

        const href = link.getAttribute('href');
        if (!href || prefetchedUrls.has(href)) return;

        const url = new URL(href, window.location.href);
        if (
          url.origin !== window.location.origin ||
          url.pathname === window.location.pathname ||
          url.hash
        )
          return;

        prefetchedUrls.add(href);

        const addPrefetch = () => {
          const prefetchLink = document.createElement('link');
          prefetchLink.rel = 'prefetch';
          prefetchLink.as = 'document';
          prefetchLink.href = url.pathname;
          document.head.appendChild(prefetchLink);
        };

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(addPrefetch, { timeout: 1000 });
        } else {
          window.setTimeout(addPrefetch, 120);
        }
      });
    </script>
  </body>
</html>
