---
const themes = [
  { name: 'latte', label: 'Latte 🌻', emoji: '🌻' },
  { name: 'frappe', label: 'Frappé 🪴', emoji: '🪴' },
  { name: 'macchiato', label: 'Macchiato 🌺', emoji: '🌺' },
  { name: 'mocha', label: 'Mocha 🌿', emoji: '🌿' },
];
---

<details id="theme-dropdown">
  <summary class="cursor-pointer inline-flex items-center justify-center h-10 px-3 rounded-md hover:opacity-75 transition-opacity" title="Catppuccin themes" aria-label="Theme">
    <span class="text-lg theme-emoji" aria-hidden="true">🌿</span>
  </summary>
  <div class="absolute right-4 sm:right-6 lg:right-8 top-[calc(100%+0.5rem)] w-44 bg-ctp-surface0 border border-ctp-surface1 rounded-lg shadow-xl z-50" role="group" aria-label="Catppuccin themes">
    <div class="px-4 py-2 text-sm text-ctp-subtext0 border-b border-ctp-surface1 rounded-t-lg" aria-hidden="true">
      Catppuccin
    </div>
    {
      themes.map((theme) => (
        <button
          type="button"
          class="theme-option w-full text-left px-4 py-3 text-ctp-text hover:bg-ctp-surface1 first:rounded-t-lg last:rounded-b-lg aria-pressed:bg-ctp-surface1 aria-pressed:text-ctp-mauve"
          data-theme={theme.name}
          aria-pressed="false"
        >
          {theme.label}
        </button>
      ))
    }
  </div>
</details>

<script>
  import { createMenuKeyHandler } from '../scripts/menu-keyboard';

  type ThemeName = 'latte' | 'frappe' | 'macchiato' | 'mocha';

  const themeMap: Record<ThemeName, string> = {
    latte: '🌻',
    frappe: '🪴',
    macchiato: '🌺',
    mocha: '🌿',
  };

  const dropdown = document.getElementById('theme-dropdown');
  if (dropdown instanceof HTMLDetailsElement) {
    const summary = dropdown.querySelector<HTMLElement>('summary');
    const themeEmoji = dropdown.querySelector<HTMLElement>('.theme-emoji');
    const themeOptions = Array.from(dropdown.querySelectorAll<HTMLButtonElement>('.theme-option'));

    const updateEmojiDisplay = (theme: string) => {
      if (themeEmoji) themeEmoji.textContent = themeMap[theme as ThemeName] || '🌿';
    };

    const updatePressedState = (theme: string) => {
      themeOptions.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.getAttribute('data-theme') === theme ? 'true' : 'false');
      });
    };

    const applyTheme = (theme: string) => {
      document.documentElement.classList.remove('latte', 'frappe', 'macchiato', 'mocha');
      document.documentElement.classList.add(theme);
      localStorage.setItem('theme', theme);
      updateEmojiDisplay(theme);
      updatePressedState(theme);
      dropdown.open = false;
    };

    const currentTheme =
      document.documentElement.className.match(/(?:^|\s)(latte|frappe|macchiato|mocha)(?:\s|$)/)?.[1] ||
      'mocha';
    updateEmojiDisplay(currentTheme);
    updatePressedState(currentTheme);

    const keyHandler = createMenuKeyHandler(themeOptions, {
      onEscape: () => {
        dropdown.open = false;
        summary?.focus();
      },
    });

    themeOptions.forEach((btn) => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme');
        if (theme) applyTheme(theme);
      });
      btn.addEventListener('keydown', keyHandler);
    });

    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) themeOptions[0]?.focus();
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) dropdown.open = false;
    });
  }
</script>
