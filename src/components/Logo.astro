---
interface Props {
  variant?: 'icon' | 'horizontal' | 'stacked';
}

const { variant = 'horizontal' } = Astro.props;
---

{variant === 'icon' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="logo logo-icon" role="img" aria-label="tyler pyramid mark">
    <polygon points="128,33 40,158 128,189" fill="currentColor"/>
    <polygon points="128,33 40,158 128,189 216,158" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
    <line x1="128" y1="33" x2="128" y2="189" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </svg>
)}
{variant === 'horizontal' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 96" class="logo logo-horizontal" role="img" aria-label="tyler logo, horizontal">
    <polygon points="48,16 12,67.5 48,80" fill="currentColor"/>
    <polygon points="48,16 12,67.5 48,80 84,67.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    <line x1="48" y1="16" x2="48" y2="80" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <text x="105" y="64" font-family="Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="44" font-weight="500" fill="currentColor" letter-spacing="-1">tyler</text>
  </svg>
)}
{variant === 'stacked' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 200" class="logo logo-stacked" role="img" aria-label="tyler logo, stacked">
    <polygon points="80,20 30,93 80,110" fill="currentColor"/>
    <polygon points="80,20 30,93 80,110 130,93" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
    <line x1="80" y1="20" x2="80" y2="110" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    <text x="80" y="165" text-anchor="middle" font-family="Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="36" font-weight="500" fill="currentColor" letter-spacing="-0.8">tyler</text>
  </svg>
)}

<style>
  .logo {
    height: 2.5rem;
    width: auto;
    color: var(--catppuccin-color-mauve);
  }

  .logo-icon {
    height: 3rem;
  }

  .logo-horizontal {
    height: 2.5rem;
  }

  .logo-stacked {
    height: 3rem;
  }

  @media (max-width: 640px) {
    .logo-stacked {
      display: none;
    }
  }
</style>
