---
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import EmailIcon from './icons/EmailIcon.astro';

interface SocialLink {
  name: string;
  href: string;
  Icon: typeof GitHubIcon;
  color: string;
  external: boolean;
}

const socialLinks: SocialLink[] = [
  {
    name: 'GitHub',
    href: 'https://github.com/tylerrosnett',
    Icon: GitHubIcon,
    color: 'hover:text-ctp-peach',
    external: true,
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/tylerrosnett',
    Icon: LinkedInIcon,
    color: 'hover:text-ctp-sky',
    external: true,
  },
  {
    name: 'Email',
    href: 'mailto:mail@tylerrosnett.com',
    Icon: EmailIcon,
    color: 'hover:text-ctp-yellow',
    external: false,
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-ctp-surface0 bg-ctp-base pt-12 flex justify-center">
  <div class="w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col items-center gap-8">
      <!-- Social Links -->
      <div class="flex gap-6">
        {socialLinks.map(({ name, href, Icon, color, external }) => (
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            aria-label={name}
            class={`text-ctp-subtext0 transition-colors duration-200 ${color}`}
          >
            <Icon />
          </a>
        ))}
      </div>

      <!-- Copyright Text -->
      <p class="text-sm text-ctp-subtext0">&copy; {currentYear} Tyler Rosnett. All rights reserved.</p>
    </div>
  </div>
</footer>
