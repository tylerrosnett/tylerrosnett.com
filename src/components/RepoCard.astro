---
interface Props {
  name: string;
  description?: string;
  url: string;
  language?: string;
  stars: number;
  forks: number;
}

const { name, description, url, language, stars, forks } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="block p-6 rounded-lg bg-ctp-surface0 border border-ctp-surface1 hover:border-ctp-mauve hover:bg-ctp-surface1 hover:-translate-y-0.5 hover:shadow-lg transition duration-200"
>
  <h2 class="text-lg font-semibold text-ctp-text pb-2">{name}</h2>
  {description && <p class="text-sm text-ctp-subtext1 pb-4 line-clamp-2">{description}</p>}
  <div class="flex items-center gap-4 text-xs text-ctp-subtext0">
    {language && (
      <span class="flex items-center gap-1.5" aria-label={`Primary language: ${language}`}>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
          <path d="M4.72 3.22a.75.75 0 0 1 1.06 1.06L2.06 8l3.72 3.72a.75.75 0 1 1-1.06 1.06L.47 8.53a.75.75 0 0 1 0-1.06Zm6.56 0a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L13.94 8l-3.72-3.72a.75.75 0 0 1 0-1.06Z" />
        </svg>
        {language}
      </span>
    )}
    <span class="flex items-center gap-1.5" aria-label={`${stars.toLocaleString()} stars`}>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
      </svg>
      {stars.toLocaleString()}
    </span>
    <span class="flex items-center gap-1.5" aria-label={`${forks.toLocaleString()} forks`}>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
      </svg>
      {forks.toLocaleString()}
    </span>
  </div>
</a>
