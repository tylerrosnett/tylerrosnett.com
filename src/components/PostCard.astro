---
interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
}

const { title, date, description, slug } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<a
  href={`/blog/${slug}`}
  class="block p-6 rounded-lg border border-ctp-surface0 hover:border-ctp-mauve hover:bg-ctp-surface0 transition-all"
>
  <h2 class="text-lg font-semibold text-ctp-text pb-2">{title}</h2>
  <p class="text-xs text-ctp-subtext0 pb-3">{formattedDate}</p>
  <p class="text-sm text-ctp-subtext1 line-clamp-2">{description}</p>
</a>
