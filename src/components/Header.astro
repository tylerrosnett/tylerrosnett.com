---
import ThemeDropdown from './ThemeDropdown.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const ariaCurrent = (href: string) => (isCurrent(href) ? 'page' : undefined);
---

<header class="border-b border-ctp-surface0 bg-ctp-base flex justify-center">
  <nav class="w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between relative" aria-label="Primary">
    <a href="/" class="logo-link h-10 px-2 rounded-md gap-0 sm:gap-2" aria-label="Tyler Rosnett — home">
      <Logo variant="icon" />
      <span class="text-xl font-bold text-ctp-text hidden sm:inline">tyler rosnett</span>
    </a>
    <div class="flex items-center gap-2">
      <div class="hidden sm:flex gap-1">
        <a href="/" aria-current={ariaCurrent('/')} class="inline-flex items-center h-10 px-3 rounded-md text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors aria-[current=page]:text-ctp-mauve aria-[current=page]:underline">about</a>
        <a href="/blog" aria-current={ariaCurrent('/blog')} class="inline-flex items-center h-10 px-3 rounded-md text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors aria-[current=page]:text-ctp-mauve aria-[current=page]:underline">blog</a>
        <a href="/repos" aria-current={ariaCurrent('/repos')} class="inline-flex items-center h-10 px-3 rounded-md text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors aria-[current=page]:text-ctp-mauve aria-[current=page]:underline">repos</a>
        <a href="/cats" aria-current={ariaCurrent('/cats')} class="inline-flex items-center h-10 px-3 rounded-md text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors aria-[current=page]:text-ctp-mauve aria-[current=page]:underline">cats</a>
      </div>

      <button id="menu-toggle" class="sm:hidden inline-flex items-center justify-center h-10 w-10 rounded-md text-ctp-text hover:text-ctp-mauve transition-colors" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <ThemeDropdown />
    </div>

    <div id="mobile-menu" class="hidden sm:hidden absolute top-[calc(100%+0.5rem)] right-4 sm:right-6 lg:right-8 w-44 bg-ctp-surface0 border border-ctp-surface1 rounded-lg shadow-xl z-50">
      <div class="py-1">
        <a href="/" aria-current={ariaCurrent('/')} class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 first:rounded-t-lg transition-colors aria-[current=page]:text-ctp-mauve">about</a>
        <a href="/blog" aria-current={ariaCurrent('/blog')} class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 transition-colors aria-[current=page]:text-ctp-mauve">blog</a>
        <a href="/repos" aria-current={ariaCurrent('/repos')} class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 transition-colors aria-[current=page]:text-ctp-mauve">repos</a>
        <a href="/cats" aria-current={ariaCurrent('/cats')} class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 last:rounded-b-lg transition-colors aria-[current=page]:text-ctp-mauve">cats</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .logo-link {
    display: flex;
    align-items: center;
  }

  .logo-link:hover {
    opacity: 0.8;
  }
</style>

<script>
  import { createMenuKeyHandler } from '../scripts/menu-keyboard';

  interface MobileMenuOptions {
    onOpen?: () => void;
  }

  class MobileMenu {
    private toggle: HTMLButtonElement;
    private menu: HTMLElement;
    private items: HTMLAnchorElement[];
    private onOpenCallback?: () => void;

    constructor(toggle: HTMLButtonElement, menu: HTMLElement, options: MobileMenuOptions = {}) {
      this.toggle = toggle;
      this.menu = menu;
      this.items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
      this.onOpenCallback = options.onOpen;

      const keyHandler = createMenuKeyHandler(this.items, {
        onEscape: () => this.close(),
      });

      this.toggle.addEventListener('click', this.onToggleClick);
      this.items.forEach((item) => {
        item.addEventListener('click', this.onItemClick);
        item.addEventListener('keydown', keyHandler);
      });
      document.addEventListener('click', this.onDocClick);
    }

    get isOpen(): boolean {
      return !this.menu.classList.contains('hidden');
    }

    open(): void {
      if (this.isOpen) return;
      this.onOpenCallback?.();
      this.menu.classList.remove('hidden');
      this.toggle.setAttribute('aria-expanded', 'true');
      this.items[0]?.focus();
    }

    close(restoreFocus = true): void {
      if (!this.isOpen) return;
      this.menu.classList.add('hidden');
      this.toggle.setAttribute('aria-expanded', 'false');
      if (restoreFocus) this.toggle.focus();
    }

    private onToggleClick = (e: MouseEvent): void => {
      e.stopPropagation();
      this.isOpen ? this.close() : this.open();
    };

    private onItemClick = (): void => {
      // Don't restore focus to the toggle — the link is about to navigate.
      this.close(false);
    };

    private onDocClick = (e: MouseEvent): void => {
      if (!this.isOpen) return;
      const target = e.target as Node;
      if (!this.menu.contains(target) && !this.toggle.contains(target)) {
        this.close(false);
      }
    };
  }

  const toggleEl = document.getElementById('menu-toggle');
  const menuEl = document.getElementById('mobile-menu');
  const themeDetails = document.getElementById('theme-dropdown');

  const mobileMenu =
    toggleEl instanceof HTMLButtonElement && menuEl instanceof HTMLElement
      ? new MobileMenu(toggleEl, menuEl, {
          onOpen: () => {
            if (themeDetails instanceof HTMLDetailsElement) themeDetails.open = false;
          },
        })
      : null;

  // Close the mobile menu when the theme dropdown opens.
  if (themeDetails instanceof HTMLDetailsElement) {
    themeDetails.addEventListener('toggle', () => {
      if (themeDetails.open) mobileMenu?.close(false);
    });
  }

  // Suppress redundant navigation when a nav link targets the current page.
  document.querySelectorAll<HTMLAnchorElement>('header nav a').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (link.pathname === location.pathname && !link.hash) {
        e.preventDefault();
        mobileMenu?.close(false);
      }
    });
  });
</script>
