---
import ThemeDropdown from './ThemeDropdown.astro';
import Logo from './Logo.astro';
---

<header class="border-b border-ctp-surface0 bg-ctp-base relative">
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
    <a href="/" class="logo-link gap-0 sm:gap-2">
      <Logo variant="icon" />
      <span class="text-xl font-bold text-ctp-text hidden sm:inline">tyler rosnett</span>
    </a>
    <div class="flex items-center gap-4">
      <div class="hidden sm:flex gap-6">
        <a href="/" class="text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors">about</a>
        <a href="/blog" class="text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors">blog</a>
        <a href="/repos" class="text-ctp-text hover:text-ctp-mauve hover:underline underline-offset-4 transition-colors">repos</a>
        <a href="/cats" class="text-ctp-text hover:text-ctp-pink hover:underline underline-offset-4 transition-colors">cats</a>
      </div>

      <button id="menu-toggle" class="sm:hidden text-ctp-text hover:text-ctp-mauve transition-colors" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <ThemeDropdown />
    </div>
  </nav>

  <div id="mobile-menu" class="hidden sm:hidden absolute top-full right-4 mt-2 w-44 bg-ctp-surface0 border border-ctp-surface1 rounded-lg shadow-xl z-50">
    <div class="py-1">
      <a href="/" class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 first:rounded-t-lg transition-colors">about</a>
      <a href="/blog" class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 transition-colors">blog</a>
      <a href="/repos" class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 transition-colors">repos</a>
      <a href="/cats" class="block px-4 py-3 text-ctp-text hover:bg-ctp-surface1 last:rounded-b-lg transition-colors">cats</a>
    </div>
  </div>
</header>

<style>
  .logo-link {
    display: flex;
    align-items: center;
  }

  .logo-link:hover {
    opacity: 0.8;
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const themeDetails = document.querySelector('header details');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileMenu.classList.toggle('hidden');
      if (!mobileMenu.classList.contains('hidden') && themeDetails instanceof HTMLDetailsElement) {
        themeDetails.open = false;
      }
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });

    document.addEventListener('click', (e) => {
      if (
        !mobileMenu.classList.contains('hidden') &&
        !mobileMenu.contains(e.target as Node) &&
        !menuToggle.contains(e.target as Node)
      ) {
        mobileMenu.classList.add('hidden');
      }
    });
  }

  if (themeDetails instanceof HTMLDetailsElement && mobileMenu) {
    themeDetails.addEventListener('toggle', () => {
      if (themeDetails.open) {
        mobileMenu.classList.add('hidden');
      }
    });
  }

  document.querySelectorAll<HTMLAnchorElement>('header nav a, #mobile-menu a').forEach(link => {
    link.addEventListener('click', (e) => {
      if (link.pathname === location.pathname && !link.hash) {
        e.preventDefault();
        if (mobileMenu) mobileMenu.classList.add('hidden');
      }
    });
  });
</script>
