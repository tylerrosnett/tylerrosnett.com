---
import Base from '../layouts/Base.astro';
import Resume from '../content/resume.md';
---

<Base title="Resume - Tyler Rosnett" description="Professional resume and experience">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/" class="text-ctp-mauve hover:text-ctp-lavender transition-colors pb-8 inline-block">
      ← back
    </a>

    <div class="prose-ctp max-w-none
                    [&_h1]:text-4xl [&_h1]:pb-2
                    [&_h2]:text-2xl [&_h2]:pt-8 [&_h2]:pb-4
                    [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:pt-6 [&_h3]:pb-2
                    [&_p]:pb-2
                    [&_ul]:space-y-1 [&_ul]:pb-4 [&_ul]:pl-4">
      <Resume />
    </div>
  </div>
</Base>
