---
import Base from '../layouts/Base.astro';
import Resume from '../content/resume.md';
---

<Base title="Resume - Tyler Rosnett" description="Professional resume and experience">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <a href="/" class="text-ctp-mauve hover:text-ctp-lavender transition-colors mb-8 inline-block">
      ← back
    </a>

    <div class="prose max-w-none
                    text-ctp-text
                    [&_h1]:text-4xl [&_h1]:font-bold [&_h1]:text-ctp-text [&_h1]:mb-2
                    [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-ctp-text [&_h2]:mt-8 [&_h2]:mb-4
                    [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-ctp-text [&_h3]:mt-6 [&_h3]:mb-2
                    [&_a]:text-ctp-mauve [&_a:hover]:text-ctp-lavender
                    [&_p]:text-ctp-subtext0 [&_p]:leading-relaxed [&_p]:mb-2
                    [&_ul]:list-disc [&_ul]:list-inside [&_ul]:space-y-1 [&_ul]:mb-4 [&_ul]:ml-4
                    [&_strong]:text-ctp-text
                    [&_em]:text-ctp-subtext0">
      <Resume />
    </div>
  </div>
</Base>
