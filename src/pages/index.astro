---
import { Image } from 'astro:assets';
import tylerImg from '../assets/tyler.jpg';
import Base from '../layouts/Base.astro';
---

<Base title="Tyler Rosnett">
  <div class="flex items-center justify-center px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-2xl w-full text-center">
      <Image src={tylerImg} alt="Tyler" loading="eager" class="w-80 h-80 rounded-full mx-auto mb-8 object-cover shadow-lg" />
      <h1 class="text-6xl font-bold text-ctp-text mb-6">hey, i'm tyler</h1>
      <div class="mb-12 text-center max-w-2xl mx-auto text-lg text-ctp-subtext0 leading-8">
        <p class="mb-4">
          Platform engineer focused on building great developer experiences. Deep expertise in Kubernetes, cloud-native architecture, and supply chain security (SLSA, SBOM, attestations). Go is my language of choice.
        </p>
        <p>
          I'm passionate about infrastructure that gets out of the way and lets teams move fast. When I'm not thinking about platforms, you'll find me playing chess, riding dirt bikes, or diving into CNCF projects.
        </p>
      </div>


    </div>
  </div>
</Base>
