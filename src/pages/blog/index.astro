---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.map(post => ({
  ...post,
  slug: post.id.replace(/\.md$/, ''),
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Blog - Tyler Rosnett"
  description="Tyler Rosnett on platform engineering, Kubernetes, and GitOps."
>
  <div class="w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="pb-12 flex flex-col items-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ctp-text pb-6 text-center">blog</h1>
      <div class="text-lg text-ctp-subtext0 leading-8 max-w-prose [&>*+*]:pt-4 text-center">
        <p>
          I like to organize and record my thoughts on certain topics and reflect on how my views change over time. This blog is my attempt at publishing that process (so don't expect well-constructed articles).
        </p>
        <p>
          The posts here are handwritten by me without any AI assistance. I'm not ready to outsource my own thoughts and feelings quite yet. Besides, if you wanted to know what the bots had to say, you would have just asked them.
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        sortedPosts.map((post) => (
          <PostCard
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            slug={post.slug}
          />
        ))
      }
    </div>
  </div>
</Base>
