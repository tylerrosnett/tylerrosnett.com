---
import { Picture } from 'astro:assets';
import catsJun from '../assets/cats-jun.jpg';
import catsOri from '../assets/cats-ori.jpg';
import catsTogether1 from '../assets/cats-together-1.jpg';
import catsTogether2 from '../assets/cats-together-2.jpg';
import Base from '../layouts/Base.astro';

const widths = [400, 600, 800, 1200];
const sizes = '(min-width: 768px) 400px, 100vw';
const imgClass = 'rounded-lg w-full object-cover aspect-square cursor-pointer';
---

<Base title="My Cats - Tyler Rosnett">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="pb-12 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ctp-text pb-6">my cats</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      <Picture src={catsJun} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt="Jun" title="Jun" loading="eager" fetchpriority="high" class={imgClass} />
      <Picture src={catsOri} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt="Ori" title="Ori" loading="eager" class={imgClass} />
      <Picture src={catsTogether1} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt="Jun and Ori" title="Jun & Ori" loading="eager" class={imgClass} />
      <Picture src={catsTogether2} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt="Jun and Ori" title="Jun & Ori" loading="eager" class={imgClass} />
    </div>
  </div>
</Base>
