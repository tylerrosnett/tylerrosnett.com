---
import { Picture } from 'astro:assets';
import catsJun1 from '../assets/cats-jun-1.jpg';
import catsJun2 from '../assets/cats-jun-2.jpg';
import catsJun3 from '../assets/cats-jun-3.jpg';
import catsJun4 from '../assets/cats-jun-4.jpg';
import catsJun5 from '../assets/cats-jun-5.jpg';
import catsJun6 from '../assets/cats-jun-6.jpg';
import catsOri1 from '../assets/cats-ori-1.jpg';
import catsOri2 from '../assets/cats-ori-2.jpg';
import catsOri3 from '../assets/cats-ori-3.jpg';
import catsOri4 from '../assets/cats-ori-4.jpg';
import catsOri5 from '../assets/cats-ori-5.jpg';
import catsTogether1 from '../assets/cats-together-1.jpg';
import catsTogether2 from '../assets/cats-together-2.jpg';
import catsTogether3 from '../assets/cats-together-3.jpg';
import Base from '../layouts/Base.astro';

const photos = [
  {
    src: catsJun1,
    caption: 'Jun',
    alt: 'Jun resting on the arm of a gray couch by a window, paws tucked, looking at the camera with bright blue eyes; a brick wall visible outside.',
  },
  {
    src: catsJun2,
    caption: 'Jun',
    alt: 'Jun belly-up and fast asleep in a cat bed, cream fur fluffed out, paws splayed.',
  },
  {
    src: catsJun3,
    caption: 'Jun',
    alt: 'Jun perched beside a bathroom sink with one paw on the counter edge, a toilet paper roll and hair dryer cord visible.',
  },
  {
    src: catsJun4,
    caption: 'Jun',
    alt: 'Jun asleep with his head and paws dangling out of a small cat bed onto a wooden desk, beside a plush black tarantula toy.',
  },
  {
    src: catsJun5,
    caption: 'Jun',
    alt: 'Jun stretched out on his back in a fluffy round cat bed by a window, tail dangling off the wooden ledge below.',
  },
  {
    src: catsJun6,
    caption: 'Jun',
    alt: 'Jun standing on hardwood and looking up at the camera with wide blue eyes, whiskers fanned out, a couch in the background.',
  },
  {
    src: catsOri1,
    caption: 'Ori',
    alt: 'Ori sitting on hardwood floor with his fluffy tail curled up behind him, looking up at the camera with green eyes.',
  },
  {
    src: catsOri2,
    caption: 'Ori',
    alt: 'Ori sitting upright in profile on a hardwood floor, sunlight catching his long white chest fur.',
  },
  {
    src: catsOri3,
    caption: 'Ori',
    alt: 'Close-up of Ori perched on top of a cat tree, head tilted, with a pink cartoon rabbit-ear filter overlaid on the photo.',
  },
  {
    src: catsOri4,
    caption: 'Ori',
    alt: 'Ori in a loaf inside a carpeted nook, paws tucked, peering out at the camera with big green eyes.',
  },
  {
    src: catsOri5,
    caption: 'Ori',
    alt: 'Ori perched on top of a tall scratching post against a beige wall, with a chandelier and doorway visible beyond.',
  },
  {
    src: catsTogether1,
    caption: 'Jun & Ori',
    alt: 'Ori the tabby sitting upright behind Jun the cream cat, who lies stretched across a wooden desk; both look at the camera, window blinds behind them.',
  },
  {
    src: catsTogether2,
    caption: 'Jun & Ori',
    alt: 'Jun and Ori in matching loaf poses on a desk between a computer monitor and a mechanical keyboard, both looking straight at the camera.',
  },
  {
    src: catsTogether3,
    caption: 'Jun & Ori',
    alt: 'Jun sitting in the foreground on a carpeted floor while Ori watches from a few feet behind, both with eyes on the camera.',
  },
];
---

<Base
  title="My Cats - Tyler Rosnett"
  description="Photos of Ori and Jun, Tyler Rosnett's cats."
>
  <div class="w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="pb-12 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ctp-text pb-6">my cats</h1>
    </div>

    <section class="slideshow" aria-label="Cat photo slideshow">
      <div class="slide-frame">
        {photos.map((photo, i) => (
          <button
            type="button"
            class="slide"
            data-index={i}
            data-active={i === 0 ? '' : undefined}
            aria-label={`Open photo ${i + 1} of ${photos.length}, ${photo.caption}`}
          >
            <Picture
              src={photo.src}
              formats={['avif', 'webp']}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 896px) 832px, 100vw"
              alt={photo.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              class="slide-image"
            />
          </button>
        ))}
        <button type="button" class="slide-nav slide-prev" aria-label="Previous photo">&#10094;</button>
        <button type="button" class="slide-nav slide-next" aria-label="Next photo">&#10095;</button>
      </div>

      <p class="slide-caption" aria-live="polite">{photos[0]?.caption}</p>

      <div class="thumb-row" role="group" aria-label="Choose a photo">
        {photos.map((photo, i) => (
          <button
            type="button"
            class="thumb"
            data-index={i}
            data-caption={photo.caption}
            aria-current={i === 0 ? 'true' : undefined}
            aria-label={`Show photo ${i + 1} of ${photos.length}, ${photo.caption}`}
          >
            <Picture
              src={photo.src}
              formats={['avif', 'webp']}
              widths={[160, 240, 320]}
              sizes="80px"
              alt=""
              loading="lazy"
              class="thumb-image"
            />
          </button>
        ))}
      </div>
    </section>
  </div>

  <dialog id="cats-lightbox" class="cats-lightbox" aria-label="Cat photos">
    <div class="lightbox-slides">
      {photos.map((photo, i) => (
        <figure class="lightbox-slide" data-index={i} data-active={i === 0 ? '' : undefined}>
          <Picture
            src={photo.src}
            formats={['avif', 'webp']}
            widths={[1200, 1600, 2000]}
            sizes="100vw"
            alt={photo.alt}
            loading="lazy"
            class="lightbox-image"
          />
          <figcaption class="lightbox-caption">{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
    <button type="button" class="lightbox-btn lightbox-close" aria-label="Close">×</button>
    <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lightbox-btn lightbox-next" aria-label="Next photo">›</button>
  </dialog>
</Base>

<style>
  .slideshow {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .slide-frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    overflow: hidden;
    touch-action: pan-y;
  }

  .slide {
    display: none;
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .slide[data-active] {
    display: block;
  }

  .slide picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slide-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 0.4);
    color: white;
    font-size: 1.25rem;
    border: 0;
    border-radius: 0.25rem;
    cursor: pointer;
    z-index: 3;
    transition: background 150ms;
  }

  .slide-nav:hover {
    background: rgb(0 0 0 / 0.7);
  }

  .slide-prev { left: 0.5rem; }
  .slide-next { right: 0.5rem; }

  .slide-caption {
    text-align: center;
    color: var(--catppuccin-color-subtext0);
    font-size: 0.875rem;
    min-height: 1.25rem;
  }

  .thumb-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .thumb {
    flex: 0 0 auto;
    width: 5rem;
    height: 5rem;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 0.5rem;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.7;
    scroll-snap-align: center;
    transition: opacity 200ms ease, outline-color 200ms ease;
  }

  .thumb:hover {
    opacity: 1;
  }

  .thumb[aria-current="true"] {
    opacity: 1;
    outline: 2px solid var(--catppuccin-color-mauve);
    outline-offset: 2px;
  }

  .thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cats-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.95);
    color: var(--catppuccin-color-text);
  }

  .cats-lightbox::backdrop {
    background: rgb(0 0 0 / 0.95);
  }

  .lightbox-slides {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .lightbox-slide {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    max-height: 100%;
  }

  .lightbox-slide[data-active] {
    display: flex;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .lightbox-caption {
    font-size: 0.875rem;
    color: var(--catppuccin-color-subtext0);
    text-align: center;
  }

  .lightbox-btn {
    position: absolute;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: var(--catppuccin-color-surface0);
    color: var(--catppuccin-color-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    border: 0;
    cursor: pointer;
  }

  .lightbox-btn:hover {
    background: var(--catppuccin-color-surface1);
  }

  .lightbox-close { top: 1rem; right: 1rem; }
  .lightbox-prev  { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lightbox-next  { right: 1rem; top: 50%; transform: translateY(-50%); }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));
  const captionEl = document.querySelector<HTMLElement>('.slide-caption');
  const slidePrev = document.querySelector<HTMLButtonElement>('.slide-prev');
  const slideNext = document.querySelector<HTMLButtonElement>('.slide-next');

  const dialog = document.getElementById('cats-lightbox');
  const lightboxSlides = Array.from(document.querySelectorAll<HTMLElement>('.lightbox-slide'));
  const lightboxClose = document.querySelector<HTMLButtonElement>('.lightbox-close');
  const lightboxPrev = document.querySelector<HTMLButtonElement>('.lightbox-prev');
  const lightboxNext = document.querySelector<HTMLButtonElement>('.lightbox-next');

  if (slides.length > 0 && thumbs.length === slides.length) {
    let activeIndex = 0;
    let suppressClick = false;

    const toggleAttr = (el: HTMLElement, attr: string, on: boolean, value = '') => {
      if (on) el.setAttribute(attr, value);
      else el.removeAttribute(attr);
    };

    const show = (index: number) => {
      activeIndex = ((index % slides.length) + slides.length) % slides.length;
      slides.forEach((s, i) => toggleAttr(s, 'data-active', i === activeIndex));
      thumbs.forEach((t, i) => toggleAttr(t, 'aria-current', i === activeIndex, 'true'));
      lightboxSlides.forEach((s, i) => toggleAttr(s, 'data-active', i === activeIndex));
      if (captionEl) {
        captionEl.textContent = thumbs[activeIndex]?.getAttribute('data-caption') ?? '';
      }
      thumbs[activeIndex]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    // Touch-swipe to change photos. Touch-only, so desktop click behavior is untouched.
    // Listeners stay passive (no preventDefault) to preserve native scroll and pinch-zoom;
    // a swipe is only registered when the gesture is clearly horizontal.
    const addSwipe = (target: HTMLElement, onSwipe: (dir: 1 | -1) => void) => {
      let startX = 0;
      let startY = 0;
      let tracking = false;
      target.addEventListener('touchstart', (e) => {
        const t = e.touches.length === 1 ? e.touches[0] : null;
        tracking = t !== null;
        suppressClick = false;
        if (t) {
          startX = t.clientX;
          startY = t.clientY;
        }
      }, { passive: true });
      target.addEventListener('touchend', (e) => {
        if (!tracking) return;
        tracking = false;
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy)) return;
        suppressClick = true;
        onSwipe(dx < 0 ? 1 : -1);
      }, { passive: true });
    };

    const openLightboxAt = (index: number) => {
      show(index);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    };

    slides.forEach((slide) => {
      slide.addEventListener('click', () => {
        if (suppressClick) return;
        const i = Number(slide.getAttribute('data-index') ?? 0);
        openLightboxAt(i);
      });
      slide.addEventListener('keydown', (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          show(activeIndex - 1);
          slides[activeIndex]?.focus();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          show(activeIndex + 1);
          slides[activeIndex]?.focus();
        }
      });
    });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const i = Number(thumb.getAttribute('data-index') ?? 0);
        show(i);
      });
      thumb.addEventListener('keydown', (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          show(activeIndex - 1);
          thumbs[activeIndex]?.focus();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          show(activeIndex + 1);
          thumbs[activeIndex]?.focus();
        }
      });
    });

    slidePrev?.addEventListener('click', () => show(activeIndex - 1));
    slideNext?.addEventListener('click', () => show(activeIndex + 1));

    const slideFrame = document.querySelector<HTMLElement>('.slide-frame');
    if (slideFrame) addSwipe(slideFrame, (dir) => show(activeIndex + dir));

    // Page-level arrow keys so you can cycle photos without first focusing the hero.
    // Skip when the lightbox is open (it has its own handler), when an editable element
    // is focused, or when focus is on a thumb/slide (those have their own handlers).
    document.addEventListener('keydown', (e) => {
      if (dialog instanceof HTMLDialogElement && dialog.open) return;
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const target = e.target;
      if (target instanceof HTMLElement) {
        const tag = target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || target.isContentEditable) return;
        if (target.classList.contains('thumb') || target.classList.contains('slide')) return;
      }
      e.preventDefault();
      show(activeIndex + (e.key === 'ArrowRight' ? 1 : -1));
    });

    if (dialog instanceof HTMLDialogElement) {
      lightboxClose?.addEventListener('click', () => dialog.close());
      lightboxPrev?.addEventListener('click', () => show(activeIndex - 1));
      lightboxNext?.addEventListener('click', () => show(activeIndex + 1));

      const lightboxSlidesEl = document.querySelector<HTMLElement>('.lightbox-slides');
      if (lightboxSlidesEl) addSwipe(lightboxSlidesEl, (dir) => show(activeIndex + dir));

      document.addEventListener('keydown', (e) => {
        if (!dialog.open) return;
        if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          show(activeIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          show(activeIndex + 1);
        }
      });

      dialog.addEventListener('click', (e) => {
        if (suppressClick) return;
        if (e.target === dialog) dialog.close();
      });
    }
  }
</script>
