---
import Base from '../layouts/Base.astro';
import RepoCard from '../components/RepoCard.astro';

interface Repo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  fork: boolean;
}

let repos: Repo[] = [];
let fetchFailed = false;
try {
  const response = await fetch(
    'https://api.github.com/users/tylerrosnett/repos?sort=stars&per_page=30',
    { headers: { 'User-Agent': 'tylerrosnett.com-build' } },
  );
  if (!response.ok) throw new Error(`GitHub API ${response.status}`);
  const data: Repo[] = await response.json();
  repos = data
    .filter((r) => !r.fork && r.name !== 'tylerrosnett')
    .sort((a, b) => b.stargazers_count - a.stargazers_count);
} catch (err) {
  console.error('Failed to fetch GitHub repos at build time:', err);
  fetchFailed = true;
}
---

<Base
  title="Repos - Tyler Rosnett"
  description="Open source projects and public GitHub repositories by Tyler Rosnett."
>
  <div class="w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="pb-12 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ctp-text pb-6">repositories</h1>
    </div>

    {fetchFailed ? (
      <div class="text-ctp-red py-12">
        <p>failed to load repositories. please try again later.</p>
      </div>
    ) : repos.length === 0 ? (
      <p class="text-ctp-subtext0">no public repositories found</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {repos.map((repo) => (
          <RepoCard
            name={repo.name}
            description={repo.description ?? undefined}
            url={repo.html_url}
            language={repo.language ?? undefined}
            stars={repo.stargazers_count}
            forks={repo.forks_count}
          />
        ))}
      </div>
    )}
  </div>
</Base>
