---
import Base from '../layouts/Base.astro';
---

<Base title="Repos - Tyler Rosnett" description="My public GitHub repositories">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12">
      <h1 class="text-5xl font-bold text-ctp-text mb-4">repositories</h1>
      <p class="text-ctp-subtext0">public projects on github</p>
    </div>

    <div id="repos-container" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="col-span-1 md:col-span-2 flex items-center justify-center py-12">
        <p class="text-ctp-subtext0">loading repositories...</p>
      </div>
    </div>

    <div id="error-container" class="hidden text-ctp-red py-12">
      <p>failed to load repositories. please try again later.</p>
    </div>
  </div>
</Base>

<script>
  interface Repo {
    name: string;
    description: string | null;
    html_url: string;
    language: string | null;
    stargazers_count: number;
    forks_count: number;
    fork: boolean;
  }

  async function loadRepos() {
    try {
      const response = await fetch('https://api.github.com/users/tylerrosnett/repos?sort=stars&per_page=30');
      if (!response.ok) throw new Error('Failed to fetch repos');

      const repos: Repo[] = await response.json();
      const filtered = repos.filter((repo) => !repo.fork).sort((a, b) => b.stargazers_count - a.stargazers_count);

      const container = document.getElementById('repos-container');
      if (container) {
        if (filtered.length === 0) {
          container.innerHTML = '<p class="text-ctp-subtext0">no public repositories found</p>';
          return;
        }

        container.innerHTML = filtered
          .map(
            (repo) => `
          <a
            href="${repo.html_url}"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-6 rounded-lg bg-ctp-surface0 hover:bg-ctp-surface1 border border-ctp-surface1 hover:border-ctp-mauve transition-all"
          >
            <h3 class="text-lg font-semibold text-ctp-text mb-2">${repo.name}</h3>
            ${repo.description ? `<p class="text-sm text-ctp-subtext0 mb-4 line-clamp-2">${repo.description}</p>` : ''}
            <div class="flex items-center gap-4 text-xs text-ctp-subtext1">
              ${repo.language ? `<span class="flex items-center gap-1">⊙ ${repo.language}</span>` : ''}
              <span class="flex items-center gap-1">⭐ ${repo.stargazers_count.toLocaleString()}</span>
              <span class="flex items-center gap-1">🍴 ${repo.forks_count.toLocaleString()}</span>
            </div>
          </a>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Error loading repos:', error);
      const errorContainer = document.getElementById('error-container');
      const container = document.getElementById('repos-container');
      if (errorContainer) errorContainer.classList.remove('hidden');
      if (container) container.classList.add('hidden');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadRepos);
  } else {
    loadRepos();
  }
</script>
