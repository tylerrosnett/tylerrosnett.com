---
import Base from '../layouts/Base.astro';
import RepoCard from '../components/RepoCard.astro';

interface Repo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  fork: boolean;
}

let repos: Repo[] = [];
let loadError = false;

try {
  const response = await fetch('https://api.github.com/users/tylerrosnett/repos?sort=stars&per_page=30', {
    headers: { 'User-Agent': 'tylerrosnett.com' },
  });
  if (!response.ok) throw new Error(`GitHub API ${response.status}`);
  const all = (await response.json()) as Repo[];
  repos = all.filter((r) => !r.fork).sort((a, b) => b.stargazers_count - a.stargazers_count);
} catch (err) {
  console.error('Failed to fetch repos at build time:', err);
  loadError = true;
}
---

<Base title="Repos - Tyler Rosnett" description="My public GitHub repositories">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12">
      <h1 class="text-5xl font-bold text-ctp-text mb-4">repositories</h1>
      <p class="text-ctp-subtext0">public projects on github</p>
    </div>

    {loadError ? (
      <p class="text-ctp-red py-12">failed to load repositories.</p>
    ) : repos.length === 0 ? (
      <p class="text-ctp-subtext0 py-12">no public repositories found</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {repos.map((repo) => (
          <RepoCard
            name={repo.name}
            description={repo.description ?? undefined}
            url={repo.html_url}
            language={repo.language ?? undefined}
            stars={repo.stargazers_count}
            forks={repo.forks_count}
          />
        ))}
      </div>
    )}
  </div>
</Base>