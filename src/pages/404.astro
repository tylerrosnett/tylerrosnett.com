---
import Base from '../layouts/Base.astro';
---

<Base title="404 - Tyler Rosnett" description="Page not found" noindex={true}>
  <div class="flex items-center justify-center px-4 sm:px-6 lg:px-8 py-24">
    <div class="max-w-2xl w-full text-center">
      <p class="text-ctp-mauve text-sm font-mono tracking-widest mb-4">ERROR 404</p>
      <h1 class="text-7xl sm:text-8xl font-bold text-ctp-text mb-6">page not found</h1>
      <p class="text-ctp-subtext0 text-lg leading-8 mb-12">
        the page you're looking for doesn't exist, has moved, or maybe never did.
      </p>
      <a
        href="/"
        class="inline-block text-ctp-mauve hover:text-ctp-lavender transition-colors text-lg"
      >
        ← back home
      </a>
    </div>
  </div>
</Base>
