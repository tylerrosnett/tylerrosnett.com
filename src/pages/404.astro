---
import Base from '../layouts/Base.astro';
---

<Base title="404 - Tyler Rosnett" description="Page not found" noindex={true}>
  <div class="w-full max-w-2xl flex flex-col items-center px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center">
      <p class="text-ctp-mauve text-sm font-mono tracking-widest pb-4">ERROR 404</p>
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold text-ctp-text pb-6">page not found</h1>
      <p class="text-ctp-subtext0 text-lg leading-8 pb-12">
        the page you're looking for doesn't exist, has moved, or maybe never did.
      </p>
      <a
        href="/"
        class="inline-block text-ctp-mauve hover:text-ctp-lavender transition-colors text-lg"
      >
        ← back home
      </a>
    </div>
  </div>
</Base>
